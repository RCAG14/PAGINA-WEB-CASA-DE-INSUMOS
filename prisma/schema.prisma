// Prisma schema — Casa de Insumos ERP/WMS
// PostgreSQL (Supabase), nombres de campo en snake_case tal como fueron especificados.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 ya no acepta `url`/`directUrl` aquí: las cadenas de conexión viven
// en prisma.config.ts (CLI/migraciones) y en el adapter de src/lib/prisma.ts
// (Prisma Client en runtime). Ver ambos archivos.
datasource db {
  provider = "postgresql"
}

model Clasificacion {
  id          String   @id @default(cuid())
  slug        String   @unique
  nombre      String
  descripcion String
  icono       String
  creado_en   DateTime @default(now())

  cajas Caja[]

  @@map("clasificaciones")
}

model Producto {
  id                 String   @id @default(cuid())
  nombre             String
  precio_referencial Decimal  @db.Decimal(10, 2)
  creado_en          DateTime @default(now())

  detalles DetalleCaja[]

  @@map("productos")
}

model Caja {
  id     String @id @default(cuid())
  nombre String
  slug   String @unique

  sku_lote String @unique

  clasificacion_id String
  clasificacion    Clasificacion @relation(fields: [clasificacion_id], references: [id])

  // "listada" revela el manifiesto exacto en la UI; "sorpresa" lo oculta.
  tipo_venta String

  descripcion_corta   String
  descripcion_tecnica String

  manifiesto             String
  origen                 String
  centro_retorno         String
  certificacion_aduanera String
  grado_liquidacion      String
  peso_bruto             String
  dimensiones            String

  costo_total       Decimal @db.Decimal(10, 2)
  precio_venta_caja Decimal @db.Decimal(10, 2)
  stock_disponible  Int     @default(0)

  // Solo aplica cuando tipo_venta = "sorpresa": rango de contenido posible,
  // ya que el detalle exacto no se define fila por fila como en las cajas listadas.
  cantidad_estimada_min Int?
  cantidad_estimada_max Int?
  valor_estimado_min    Decimal? @db.Decimal(10, 2)
  valor_estimado_max    Decimal? @db.Decimal(10, 2)

  destacada   Boolean @default(false)
  rating      Decimal @default(0) @db.Decimal(2, 1)
  num_resenas Int     @default(0)

  // Foto real de la caja/lote en Supabase Storage. Si es null, la UI cae al
  // ícono de clasificación (ver BoxVisual) en vez de romper el layout.
  imagen_url  String?
  imagen_path String?

  creado_en      DateTime @default(now())
  actualizado_en DateTime @updatedAt

  detalles        DetalleCaja[]
  pedido_detalles PedidoDetalle[]

  @@map("cajas")
}

model DetalleCaja {
  id String @id @default(cuid())

  caja_id String
  caja    Caja   @relation(fields: [caja_id], references: [id], onDelete: Cascade)

  producto_id String
  producto    Producto @relation(fields: [producto_id], references: [id])

  cantidad  Int
  // Estado reportado del artículo devuelto (ej. "Como nuevo", "Función no verificada").
  condicion String

  costo_asignado        Decimal @db.Decimal(10, 2)
  precio_venta_sugerido Decimal @db.Decimal(10, 2)

  @@map("detalle_caja")
}

model Cliente {
  id        String  @id @default(cuid())
  nombre    String
  telefono  String
  // Usado para agrupar el historial de compras de un mismo cliente (tracking).
  // Nullable a nivel de BD por compatibilidad con pedidos históricos sin correo,
  // pero el checkout lo exige desde ahora en adelante.
  email     String? @unique
  direccion String?
  ciudad    String?

  creado_en DateTime @default(now())

  pedidos Pedido[]

  @@map("clientes")
}

// Cuentas de acceso a la plataforma: staff (panel administrador) y clientes
// registrados (login público). El modelo Cliente de arriba sigue existiendo
// aparte, solo para el tracking de pedidos del checkout (sin contraseña).
model Usuario {
  id            String @id @default(cuid())
  nombre        String
  username      String @unique
  password_hash String

  // JEFE (control total del panel) | SOCIO (solo lectura y reportes) |
  // CLIENTE (cuenta pública autorregistrada, sin acceso a /admin)
  rol String

  activo    Boolean  @default(true)
  creado_en DateTime @default(now())

  @@map("usuarios")
}

// Contador simple de visitas públicas — tráfico estimado para el dashboard
// del Socio. No es un reemplazo de una herramienta de analítica real.
model MetricaVisita {
  id        String   @id @default(cuid())
  ruta      String
  creado_en DateTime @default(now())

  @@map("metricas_visita")
}

model Pedido {
  id            String @id @default(cuid())
  codigo_pedido String @unique

  cliente_id String
  cliente    Cliente @relation(fields: [cliente_id], references: [id])

  // Pendiente | En Preparación | Enviado | Entregado | Cancelado
  estado String @default("Pendiente")

  total_estimado           Decimal  @db.Decimal(10, 2)
  fecha_creacion           DateTime @default(now())
  fecha_expiracion_reserva DateTime

  detalles PedidoDetalle[]

  @@map("pedidos")
}

model PedidoDetalle {
  id String @id @default(cuid())

  pedido_id String
  pedido    Pedido @relation(fields: [pedido_id], references: [id], onDelete: Cascade)

  caja_id String
  caja    Caja   @relation(fields: [caja_id], references: [id])

  cantidad        Int
  precio_unitario Decimal @db.Decimal(10, 2)

  @@map("pedido_detalle")
}

model MovimientoInventario {
  id String @id @default(cuid())

  // "Caja" | "Producto" — referencia polimórfica resuelta a nivel de aplicación,
  // por eso entidad_id no lleva relación de clave foránea declarada.
  tipo_entidad String
  entidad_id   String

  cantidad_cambio Int

  // Venta | Ingreso | Reserva | Cancelacion
  motivo String

  fecha DateTime @default(now())

  @@map("movimientos_inventario")
}

model RedSocial {
  id         String   @id @default(cuid())
  // instagram | facebook | tiktok | youtube | x | otro
  plataforma String
  url        String
  activo     Boolean  @default(true)
  orden      Int      @default(0)
  creado_en  DateTime @default(now())

  @@map("redes_sociales")
}

model NumeroContacto {
  id        String   @id @default(cuid())
  etiqueta  String
  numero    String
  activo    Boolean  @default(true)
  orden     Int      @default(0)
  creado_en DateTime @default(now())

  @@map("numeros_contacto")
}

// Contenido multimedia editable de la landing page (video/imágenes del Hero,
// imagen de "Sobre nosotros" y banners de promociones), todo alojado en
// Supabase Storage. El administrador lo gestiona por completo desde
// /admin/configuracion/landing sin tocar código.
model ContenidoLanding {
  id String @id @default(cuid())

  // hero_video | hero_imagen | about_imagen | banner_promo | logo
  tipo String

  // imagen | video — determina cómo se renderiza en el frontend.
  formato String

  url          String
  // Path del objeto dentro del bucket de Supabase Storage, necesario para
  // poder borrar el asset remoto al reemplazar o eliminar el registro.
  storage_path String

  titulo     String?
  subtitulo  String?
  enlace_cta String?
  texto_cta  String?

  activo Boolean @default(true)
  // Orden dentro de su propio "tipo" (ej. secuencia del carrusel del Hero).
  orden  Int     @default(0)

  creado_en      DateTime @default(now())
  actualizado_en DateTime @updatedAt

  @@map("contenido_landing")
}

// Paquetes de precio del servicio de Desarrollo Web a Medida (/desarrollo-web).
// El administrador los gestiona desde /admin/desarrollo-web sin tocar
// código. El botón de cotización de cada paquete arma un mensaje de WhatsApp
// personalizado con el nombre del paquete.
model PaqueteDesarrollo {
  id String @id @default(cuid())

  nombre  String @unique
  tagline String
  precio  Decimal @db.Decimal(10, 2)

  // Una línea por ítem del checklist de features mostrado en la tarjeta.
  features String[]

  // Se resalta visualmente como la opción recomendada en la landing.
  destacado Boolean @default(false)
  activo    Boolean @default(true)
  orden     Int     @default(0)

  creado_en      DateTime @default(now())
  actualizado_en DateTime @updatedAt

  @@map("paquetes_desarrollo")
}

// Trabajos realizados (portfolio) mostrados en /desarrollo-web, gestionados
// desde /admin/desarrollo-web. Imagen opcional alojada en Supabase
// Storage — si es null, la UI cae a un ícono según la categoría.
model TrabajoRealizado {
  id String @id @default(cuid())

  titulo String
  // Rubro del cliente — texto libre, ej. "Restaurante", "Inmobiliaria", "Clínica".
  categoria   String
  descripcion String

  imagen_url  String?
  imagen_path String?
  // Enlace opcional al sitio/demo del trabajo mostrado.
  enlace      String?

  activo Boolean @default(true)
  orden  Int     @default(0)

  creado_en      DateTime @default(now())
  actualizado_en DateTime @updatedAt

  @@map("trabajos_realizados")
}
