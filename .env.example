# Copia este archivo a .env y completa con las credenciales reales antes de migrar.

# — Base de datos (Supabase Postgres) ————————————————————————————————
# Panel de Supabase > Project Settings > Database > Connection string.
#
# DATABASE_URL: conexión POOLED vía pgbouncer (puerto 6543). La usa Prisma
# Client en runtime (src/lib/prisma.ts) — es la que corre en Vercel.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:TU_PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: conexión DIRECTA (puerto 5432, sin pgbouncer). La usan
# `prisma migrate dev/deploy`, `prisma db push` y `prisma studio`
# (prisma.config.ts) — nunca corre en Vercel, solo local/CI.
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:TU_PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# — Supabase Storage —————————————————————————————————————————————————
# Panel de Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL="https://bjnulupcejigydncgtct.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# Secreta — Project Settings > API > "service_role" / "secret key" nueva
# (sb_secret_...). Bypasea RLS del bucket, así que solo se usa en código de
# servidor (src/lib/supabase.ts, /api/upload). NUNCA la expongas al cliente
# ni la subas a git — por eso NO lleva prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="tu_service_role_o_secret_key"

# Nombre del bucket PÚBLICO donde se suben imágenes/videos (créalo en
# Storage > New bucket, marcado como "Public"). Carpetas usadas dentro:
# casa-de-insumos/landing/{hero,about,banners,logo} y casa-de-insumos/productos.
SUPABASE_STORAGE_BUCKET="casa-de-insumos"

# El número de WhatsApp usado para redirigir al cliente desde el checkout ya NO se
# configura aquí: se administra desde /admin/configuracion/contacto (tabla NumeroContacto).

# — SEO ——————————————————————————————————————————————————————————————
# URL pública final del sitio (sin slash final). Usada como metadataBase
# para generar canonical/OG tags absolutos (src/app/layout.tsx).
NEXT_PUBLIC_SITE_URL="https://casadeinsumos.com"

# Footer — mapa de la bodega y correo de contacto rápido. Son públicas por
# diseño (se renderizan en el HTML del sitio), de ahí el prefijo NEXT_PUBLIC_.
# Para el mapa: Google Maps > Compartir > Insertar un mapa > copiar solo el
# valor de src="..." del iframe generado.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL="https://www.google.com/maps/embed?pb=..."
NEXT_PUBLIC_CONTACT_EMAIL="contacto@casadeinsumos.com"

# Firma las sesiones (JWT) del panel administrador (/admin). Genera un valor
# aleatorio propio — NUNCA reuses el de otro entorno:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="genera_el_tuyo_con_el_comando_de_arriba"

# — Correo de cotizaciones (Resend) ————————————————————————————————————
# Se envía al cliente (con el admin en copia) cada vez que un pedido pasa a
# estado "Pendiente" (checkout o cambio manual en /admin/cajas/pedidos).
# API key de https://resend.com/api-keys.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Remitente. Con el plan gratis de Resend sin dominio propio verificado,
# usa "onboarding@resend.dev" (solo entrega a la cuenta dueña del API key).
# Para enviar a clientes reales, verificá tu dominio en Resend y usá algo
# como "Casa de Insumos <pedidos@casadeinsumos.com>".
EMAIL_FROM="Casa de Insumos <onboarding@resend.dev>"

# Recibe copia (CC) de cada correo de cotización.
PEDIDOS_ADMIN_EMAIL="guzrobert593@gmail.com"

# Usuario JEFE inicial creado por `npm run db:seed` (prisma/seed.ts). Si omites
# SEED_ADMIN_PASSWORD, el seed genera una contraseña aleatoria y la imprime UNA
# sola vez en la consola — cópiala en ese momento.
SEED_ADMIN_USERNAME="RCAG21"
SEED_ADMIN_PASSWORD="elige_una_contrasena_fuerte"
