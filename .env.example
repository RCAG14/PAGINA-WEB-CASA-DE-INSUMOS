# Copia este archivo a .env y completa con las credenciales reales antes de migrar.

# Cadena de conexión de SQL Server (formato Prisma clásico, usado por prisma.config.ts
# para `prisma migrate` / `prisma db push`, y parseado en src/lib/prisma.ts para el
# adaptador de Prisma Client en tiempo de ejecución).
DATABASE_URL="sqlserver://localhost:1433;database=casa_de_insumos;user=sa;password=CAMBIAR_PASSWORD;encrypt=true;trustServerCertificate=true"

# El número de WhatsApp usado para redirigir al cliente desde el checkout ya NO se
# configura aquí: se administra desde /admin/cajas/configuracion (tabla NumeroContacto).

# Cloudinary — panel > Dashboard (https://console.cloudinary.com). Usadas por
# src/lib/cloudinary.ts y por /api/upload para subir/eliminar imágenes y videos
# (inventario de cajas, Hero y banners de la landing gestionados desde
# /admin/cajas/landing). Nunca exponer API_SECRET al cliente: solo se usan en
# código de servidor (route handlers / server actions), por eso NO llevan
# prefijo NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"

# Footer — mapa de la bodega y correo de contacto rápido. Son públicas por
# diseño (se renderizan en el HTML del sitio), de ahí el prefijo NEXT_PUBLIC_.
# Para el mapa: Google Maps > Compartir > Insertar un mapa > copiar solo el
# valor de src="..." del iframe generado.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL="https://www.google.com/maps/embed?pb=..."
NEXT_PUBLIC_CONTACT_EMAIL="contacto@casadeinsumos.com"

# Firma las sesiones (JWT) del panel administrador (/admin). Genera un valor
# aleatorio propio — NUNCA reuses el de otro entorno:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="genera_el_tuyo_con_el_comando_de_arriba"

# Usuario JEFE inicial creado por `npm run db:seed` (prisma/seed.ts). Si omites
# SEED_ADMIN_PASSWORD, el seed genera una contraseña aleatoria y la imprime UNA
# sola vez en la consola — cópiala en ese momento.
SEED_ADMIN_USERNAME="RCAG21"
SEED_ADMIN_PASSWORD="elige_una_contrasena_fuerte"
